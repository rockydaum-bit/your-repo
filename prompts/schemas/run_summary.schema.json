{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "Run Summary",
  "type": "object",
  "required": ["run_id", "channel_id", "started_at", "finished_at", "status", "steps", "artifacts", "errors"],
  "properties": {
    "run_id": { "type": "string" },
    "channel_id": { "type": "string" },
    "started_at": { "type": ["string"] },
    "finished_at": { "anyOf": [{"type": "string"}, {"type": "null"}] },
    "status": { "type": "string", "enum": ["success", "partial", "failed", "paused", "running", "in_progress"] },
    "steps": {
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["success", "skipped", "failed", "not_run"] }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "message", "ts"],
        "properties": {
          "step": { "type": "string" },
          "message": { "type": "string" },
          "ts": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
